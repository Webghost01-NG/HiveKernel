# ==============================================================================
# 🐝 HIVEKERNEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Web3 / EVM Testnet RPC URLs (Optional: Defaults to local Anvil node)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ANVIL_RPC_URL=http://127.0.0.1:8545

# Agent Private Key (For signing on-chain transactions on EVM networks)
# PRIVATE_KEY=0x...

# Optional LLM Integration (For LLM-augmented audit reports alongside Rust static engine)
# OPENAI_API_KEY=sk-...
# OLLAMA_HOST=http://localhost:11434

# Logging Verbosity (trace, debug, info, warn, error)
RUST_LOG=info
